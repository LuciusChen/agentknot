{
  "description": "Load the AgentKnot contract once for each controller session lifecycle.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 2,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
