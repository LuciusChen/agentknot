{
  "description": "Run configured automatic AgentKnot delegation before the controller-model turn.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\" codex '$agentknot-delegate'",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\" codex '$agentknot-delegate'",
            "timeout": 3660,
            "statusMessage": "AgentKnot is planning, running workers, and verifying; expand for live progress",
            "additionalContextLimit": 18000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\" codex '$agentknot-delegate'",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
