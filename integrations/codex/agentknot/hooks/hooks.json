{
  "description": "Remind the controller to use the independent AgentKnot broker for eligible work.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\" codex '$agentknot-delegate'",
            "timeout": 2,
            "statusMessage": "Applying AgentKnot delegation guard",
            "additionalContextLimit": 4000
          }
        ]
      }
    ]
  }
}
