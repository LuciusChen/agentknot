{
  "description": "Run configured automatic AgentKnot delegation before the controller-model turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\" codex",
            "timeout": 3660,
            "statusMessage": "Running AgentKnot automatic delegation",
            "additionalContextLimit": 18000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\" codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
