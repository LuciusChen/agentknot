{
  "name": "agentknot",
  "version": "0.0.1",
  "description": "Vendor-neutral orchestration for coding-agent controllers, workers, and model providers.",
  "type": "module",
  "private": true,
  "bin": {
    "agentknot": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli.js',0o755)\"",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "test:stage1-soak": "npm run build --silent && node scripts/stage1-soak.mjs",
    "check": "npm test --silent",
    "dev": "node --enable-source-maps dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  }
}
